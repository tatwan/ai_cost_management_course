# Copy this file to `.env` in the repo root (or `notebooks/.env`).
# You only need ONE key. If both are set, Anthropic is used by default
# because its cache read/write buckets are easier to show on screen.
# Override with LLM_PROVIDER=openai.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# openai | anthropic
LLM_PROVIDER=openai

# Optional. Only set these if your key cannot call the defaults.
# Anthropic defaults:  claude-haiku-4-5 / claude-sonnet-5 / claude-opus-5
# OpenAI defaults:     gpt-5.6-luna / gpt-5.6-terra / gpt-5.6-sol
# MODEL_FLOOR=
# MODEL_MID=
# MODEL_FRONTIER=
